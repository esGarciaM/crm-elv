# ============================================
# CRM Patrocinios - Environment Variables
# ============================================
# Copia este archivo como .env y edita los valores
# cp .env.example .env

# ── Nginx Basic Auth (DB Manager) ──
NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_PASSWORD=admin123

# ── Backup Settings ──
BACKUP_INTERVAL=480
BACKUP_RETENTION=30
BACKUP_TZ=America/Mexico_City
